      - 格式示例: [{"type": "motion", "sensitivity": 0.5}]
    
    ### ✅ 返回信息：
    - 摄像头创建确认
    - 过滤器配置详情
    """
    try:
        # Parse filters JSON
        try:
            filters_list = json.loads(filters)
        except json.JSONDecodeError:
            raise HTTPException(status_code=400, detail="过滤器配置格式错误，必须是有效的JSON")

        # Create camera
        camera_data = CameraCreate(
            name=name,
            rtsp_url=rtsp_url,
            created_at=datetime.now().isoformat()
        )

        camera = camera_service.create_or_update_camera(camera_data)
        
        # Save filters
        camera_service.save_camera_filters(camera.id, filters_list)

        return CameraResponse(
            id=camera.id,
            name=camera.name,
            rtsp_url=camera.rtsp_url,
            message="带过滤器的摄像头创建成功"
        )

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"创建带过滤器的摄像头时出错: {str(e)}")


@router.put("/{camera_id}/filters", response_model=dict, summary="更新摄像头过滤器")
async def update_camera_filters(
    camera_id: str,
    filters: str = Form("[]")
):
    """
    ## ⚙️ 更新摄像头过滤器配置
    
    修改指定摄像头的视频流过滤器设置。
    
    ### 📝 参数说明：
    - **camera_id**: 摄像头ID
    - **filters**: 新的过滤器配置（JSON字符串）
    
    ### ✅ 返回信息：
    - 更新操作结果
    - 新的过滤器配置
    """
    try:
        # Parse filters JSON
        try:
            filters_list = json.loads(filters)
        except json.JSONDecodeError:
            raise HTTPException(status_code=400, detail="过滤器配置格式错误")

        camera_service.save_camera_filters(camera_id, filters_list)

        return {
            "状态": "成功",
            "消息": "摄像头过滤器已更新",
            "摄像头ID": camera_id,
            "过滤器数量": len(filters_list)
        }

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"更新摄像头过滤器时出错: {str(e)}")


@router.get("/{camera_id}/filters", response_model=List[FilterConfig], summary="获取摄像头过滤器")
async def get_camera_filters(camera_id: str):
    """
    ## 🔧 获取摄像头过滤器配置
    
    查看指定摄像头的所有过滤器设置。
    
    ### 📝 参数说明：
    - **camera_id**: 摄像头ID
    
    ### ✅ 返回信息：
    - 过滤器配置列表
    - 每个过滤器的详细参数
    """
    try:
        filters = camera_service.get_camera_filters(camera_id)
        return filters
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"获取摄像头过滤器时出错: {str(e)}")
