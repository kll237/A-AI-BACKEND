import sys
import os

# 设置路径
project_root = r"D:\jsjxm\A-AI-BACKEND"
sys.path.insert(0, project_root)

print("=== 测试所有导入 ===")
modules_to_test = [
    ("app.core.config", "settings"),
    ("app.api.api", "api_router"),
    ("app.ai_engine", "ai_engine"),
]

for module_name, attr_name in modules_to_test:
    try:
        module = __import__(module_name, fromlist=[attr_name])
        attr = getattr(module, attr_name)
        print(f"✓ {module_name}.{attr_name} 导入成功")
    except ImportError as e:
        print(f"✗ {module_name}.{attr_name} 导入失败: {e}")
    except AttributeError as e:
        print(f"✗ {module_name} 中没有 {attr_name}: {e}")

print(f"\n=== 测试 FastAPI 应用 ===")
try:
    from app.main import app
    print("✓ app.main.app 导入成功")
    print(f"  应用标题: {app.title}")
    print(f"  路由数量: {len(app.routes)}")
except Exception as e:
    print(f"✗ 导入失败: {e}")
'@ | python