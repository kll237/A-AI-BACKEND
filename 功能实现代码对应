  # analytics_processor.py 中的实现
class AnalyticsProcessor:
    def __init__(self, detectors):
        self.people_detector = detectors['people']
        self.face_recognizer = detectors['face']
        self.crowd_analyzer = detectors['crowd']
        self.authorization_processor = detectors['authorization']

        # 实时指标
        self.real_time_metrics = {
            'current_people_count': 0,
            'authorized_people': 0,
            'unauthorized_people': 0,
            'density_level': 'very_low',
            'security_events': [],
            'system_health': 'normal'
        }

    def process_frame(self, frame, timestamp):
        """处理单帧并更新分析指标"""
        # 1. 检测人员
        people_detections = self.people_detector.detect_persons(frame)
        self.real_time_metrics['current_people_count'] = len(people_detections)

        # 2. 人脸识别
        face_detections = self.face_recognizer.recognize_batch(frame, people_detections)

        # 3. 统计授权与未授权人员
        authorized = 0
        unauthorized = 0
        for det in face_detections:
            if det['matched_id'] is not None:
                authorized += 1
            else:
                unauthorized += 1

        self.real_time_metrics['authorized_people'] = authorized
        self.real_time_metrics['unauthorized_people'] = unauthorized

        # 4. 人群密度分析
        crowd_analysis = self.crowd_analyzer.analyze_crowd(people_detections, timestamp)
        self.real_time_metrics['density_level'] = crowd_analysis['density_level']

        # 5. 安全事件检测
        security_events = self.authorization_processor.detect_intrusions(
            face_detections, timestamp
        )
        self.real_time_metrics['security_events'] = security_events

        # 返回更新后的指标
        return self.real_time_metrics
