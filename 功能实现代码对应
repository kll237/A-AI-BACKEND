        # 加载InsightFace模型
        self.face_analyzer = insightface.app.FaceAnalysis()
        self.face_analyzer.prepare(ctx_id=-1)

    def recognize(self, face_image, min_confidence=0.7):
        # 尝试主要算法
        result = self.algorithms['face_recognition'](face_image)

        # 如果置信度不足，尝试备用算法（《计算机视觉教程》10.5节 多模态融合）
        if result['confidence'] < min_confidence:
            result = self.algorithms['insightface'](face_image)

            # 如果仍不足，尝试最后一种算法
            if result['confidence'] < min_confidence:
                result = self.algorithms['opencv'](face_image)

        return result
