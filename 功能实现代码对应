import cv2
import torch
from ultralytics import YOLO

class YOLODetector:
    def __init__(self, model_path, device="cuda" if torch.cuda.is_available() else "cpu"):
        self.model = YOLO(model_path)
        self.model.to(device)
        # 预处理参数配置，适应不同光线条件
        self.preprocess_params = {
            'brightness': 0.2,    # 亮度调整范围
            'contrast': 0.2,      # 对比度调整范围
            'saturation': 0.2     # 饱和度调整范围
        }

    def preprocess_frame(self, frame):
        # 自适应光线处理（应用《计算机视觉教程》第三版3.2节 图像增强技术）
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        # 直方图均衡化处理（教程5.3节 直方图增强方法）
        equalized = cv2.equalizeHist(gray)
        # 转换回BGR用于YOLO处理
        return cv2.cvtColor(equalized, cv2.COLOR_GRAY2BGR)

    def detect_persons(self, frame, confidence_threshold=0.5):
        # 预处理帧以适应不同光线条件
        processed_frame = self.preprocess_frame(frame)
        # 仅检测人员（类别0）
        results = self.model(processed_frame, classes=[0], conf=confidence_threshold)
        return self._parse_results(results)
