class AuthorizationProcessor:
    def __init__(self, authorized_ids, restricted_zones):
        self.authorized_ids = authorized_ids  # 授权人员ID列表
        self.restricted_zones = restricted_zones  # 限制区域定义
        self.security_events = []

    def check_authorization(self, person_id, zone_id):
        """检查人员是否有权限进入特定区域"""
        # 检查该区域是否为限制区域
        if zone_id not in self.restricted_zones:
            return True  # 非限制区域，默认允许

        # 检查人员是否有该区域的访问权限
        if person_id in self.authorized_ids.get(zone_id, []):
            return True
        return False

    def detect_intrusions(self, detections, frame_timestamp):
        """检测未经授权的进入事件"""
        current_events = []

        for detection in detections:
            person_id = detection['person_id']
            bbox = detection['bbox']
            confidence = detection['confidence']

            # 确定目标所在区域
            zone_id = self._determine_zone(bbox)

            # 未知人员或未授权人员进入限制区域
            if person_id is None or not self.check_authorization(person_id, zone_id):
                event = {
                    'event_type': 'unauthorized_entry',
                    'zone_id': zone_id,
                    'person_id': person_id,
                    'timestamp': frame_timestamp,
                    'confidence': confidence,
                    'bbox': bbox
                }
                self.security_events.append(event)
                current_events.append(event)

        return current_events
应用场景：
军事禁区安全防护
数据中心等敏感区域监控
私人财产安全防护

