2.实时处理直播视频流（延迟低于 0.5 秒）
  # stream_processor.py 中的核心实现
import cv2
import asyncio
from concurrent.futures import ThreadPoolExecutor

class StreamProcessor:
    def __init__(self, detector, rtsp_url, buffer_size=2):
        self.detector = detector
        self.rtsp_url = rtsp_url
        self.buffer = asyncio.Queue(maxsize=buffer_size)
        self.executor = ThreadPoolExecutor(max_workers=2)
        self.running = False

    async def start(self):
        self.running = True
        # 启动视频读取线程
        asyncio.create_task(self._read_frames())
        # 启动处理线程
        asyncio.create_task(self._process_frames())

    async def _read_frames(self):
        # 使用OpenCV读取RTSP流
        cap = cv2.VideoCapture(self.rtsp_url)
        while self.running and cap.isOpened():
            ret, frame = cap.read()
            if ret:
                # 限制队列大小，防止累积延迟
                if self.buffer.full():
                    await self.buffer.get()  # 移除最旧的帧
                await self.buffer.put(frame)
        cap.release()

    async def _process_frames(self):
        # 异步处理帧，控制延迟
        while self.running:
            frame = await self.buffer.get()
            # 使用线程池处理，避免阻塞事件循环
            loop = asyncio.get_event_loop()
            detections = await loop.run_in_executor(
                self.executor, self.detector.detect_persons, frame
            )
            # 处理结果并发布
            self._publish_results(detections)
