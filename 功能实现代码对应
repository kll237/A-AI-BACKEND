2.抗干扰处理（不受眼镜、光线变化影响）
  # face_detector.py 中的抗干扰实现
def _preprocess_face(self, face_image):
    # 转换为灰度图
    gray = cv2.cvtColor(face_image, cv2.COLOR_BGR2GRAY)

    # 处理眼镜反光（应用《计算机视觉教程》6.4节 反光去除）
    # 自适应阈值处理
    adaptive_thresh = cv2.adaptiveThreshold(
        gray, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY, 11, 2
    )

    # 光照归一化（教程5.4节 光照不变性处理）
    normalized = cv2.equalizeHist(gray)

    # 边缘保留滤波，减少眼镜影响
    filtered = cv2.edgePreservingFilter(normalized, flags=1, sigma_s=60, sigma_r=0.4)

    return filtered

def _recognize_face_recognition(self, face_image):
    # 预处理人脸图像
    processed = self._preprocess_face(face_image)
    # 转换回RGB格式（face_recognition库要求）
    face_rgb = cv2.cvtColor(processed, cv2.COLOR_GRAY2RGB)

    # 提取人脸特征
    encodings = face_recognition.face_encodings(face_rgb, model="large")
    if not encodings:
        return {'match': None, 'confidence': 0.0}

    # 与参考特征比较
    face_encoding = encodings[0]
    distances = face_recognition.face_distance(
        self.reference_encodings['encodings'],
        face_encoding
    )

    # 计算置信度
    min_distance = min(distances)
    confidence = 1.0 - min_distance
    match_index = distances.argmin()

    return {
        'match': self.reference_encodings['ids'][match_index],
        'confidence': confidence
    }
