3. 快速生成人脸特征与大规模比对
# face_detector.py 中的高效比对实现
import numpy as np
from sklearn.neighbors import KDTree

class FaceRecognitionEngine:
    def __init__(self):
        self.known_encodings = []
        self.known_ids = []
        self.kd_tree = None  # 用于快速检索的KD树

    def add_reference_faces(self, encodings, ids):
        """添加参考人脸特征"""
        self.known_encodings.extend(encodings)
        self.known_ids.extend(ids)
        # 构建KD树用于高效最近邻搜索（《计算机视觉教程》9.3节 特征匹配）
        self.kd_tree = KDTree(np.array(self.known_encodings))

    def batch_recognize(self, face_encodings, threshold=0.6):
        """批量处理人脸特征，支持大规模比对"""
        if not self.kd_tree:
            return []

        # 使用KD树进行高效搜索，找到每个特征的最近邻
        distances, indices = self.kd_tree.query(
            np.array(face_encodings),
            k=1  # 只返回最近的一个匹配
        )

        results = []
        for i, (distance, index) in enumerate(zip(distances, indices)):
            confidence = 1.0 - distance[0]
            if confidence >= threshold:
                results.append({
                    'face_index': i,
                    'matched_id': self.known_ids[index[0]],
                    'confidence': confidence
                })
            else:
                results.append({
                    'face_index': i,
                    'matched_id': None,
                    'confidence': confidence
                })

        return results
