  # crowd_analyzer.py 中的实现
import numpy as np
from collections import deque

class CrowdAnalyzer:
    def __init__(self, area_roi=None, history_size=30):
        # 区域兴趣点（如果指定，只统计该区域内的人员）
        self.area_roi = area_roi
        # 存储历史数据
        self.history = deque(maxlen=history_size)
        # 密度阈值
        self.density_thresholds = {
            'low': 5,
            'medium': 15,
            'high': 30
        }

    def is_inside_roi(self, bbox):
        """判断目标是否在感兴趣区域内（《计算机视觉教程》7.2节 区域选择）"""
        if not self.area_roi:
            return True

        # 计算目标中心
        x1, y1, x2, y2 = bbox
        center_x = (x1 + x2) / 2
        center_y = (y1 + y2) / 2

        # 检查点是否在ROI内（使用射线法）
        x, y = int(center_x), int(center_y)
        roi = np.array(self.area_roi, np.int32)
        return cv2.pointPolygonTest(roi, (x, y), False) >= 0

    def analyze_crowd(self, detections, timestamp):
        """分析人群密度和流动趋势"""
        # 统计感兴趣区域内的人数
        count = 0
        for det in detections:
            if self.is_inside_roi(det['bbox']):
                count += 1

        # 记录历史数据
        self.history.append({
            'timestamp': timestamp,
            'count': count
        })

        # 确定密度等级
        if count >= self.density_thresholds['high']:
            density_level = 'high'
        elif count >= self.density_thresholds['medium']:
            density_level = 'medium'
        elif count >= self.density_thresholds['low']:
            density_level = 'low'
        else:
            density_level = 'very_low'

        # 计算变化趋势
        trend = self._calculate_trend()

        return {
            'current_count': count,
            'density_level': density_level,
            'trend': trend,
            'timestamp': timestamp
        }
