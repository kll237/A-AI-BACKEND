def intelligent_match(self, face_encoding, context_data=None):
    """
    基于置信度的智能匹配，结合上下文信息减少误判
    context_data: 包含位置、时间等上下文信息
    """
    # 获取初始匹配结果
    base_result = self._basic_match(face_encoding)

    # 应用置信度阈值（《计算机视觉教程》10.7节 识别决策）
    if base_result['confidence'] > 0.85:
        # 高置信度直接返回
        return base_result
    elif base_result['confidence'] < 0.5:
        # 低置信度视为未匹配
        return {'match': None, 'confidence': base_result['confidence']}
    else:
        # 中等置信度，结合上下文信息
        return self._context_aware_matching(
            base_result,
            face_encoding,
            context_data
        )

def _context_aware_matching(self, base_result, face_encoding, context):
    """结合上下文信息的匹配决策"""
    if not context:
        return base_result

    # 检查该ID是否在该位置有过记录
    location_history = self._get_location_history(
        base_result['match'],
        context['location_id']
    )

    # 如果该ID经常出现在此位置，降低匹配阈值
    if location_history['frequency'] > 5:
        adjusted_threshold = 0.55
    else:
        adjusted_threshold = 0.7

    # 应用调整后的阈值
    if base_result['confidence'] >= adjusted_threshold:
        return base_result
    else:
        return {'match': None, 'confidence': base_result['confidence']}
