# attendance_processor.py 中的实现
from datetime import datetime, timedelta

class AttendanceProcessor:
    def __init__(self, face_recognizer, location_id):
        self.face_recognizer = face_recognizer
        self.location_id = location_id
        self.entries = {}  # 记录进入时间
        self.attendance_records = []
        # 防止重复记录的时间窗口（5分钟）
        self.cooldown_period = timedelta(minutes=5)

    def process_detections(self, detections, frame_timestamp):
        """处理检测结果，记录人员进出"""
        current_time = datetime.fromtimestamp(frame_timestamp)

        # 处理每个检测到的人脸
        for detection in detections:
            person_id = detection['person_id']
            confidence = detection['confidence']

            # 高置信度才记录
            if confidence < 0.7:
                continue

            # 检查是否是新进入
            if person_id not in self.entries:
                # 新进入记录
                self.entries[person_id] = current_time
                self.attendance_records.append({
                    'person_id': person_id,
                    'event_type': 'entry',
                    'timestamp': current_time,
                    'location_id': self.location_id,
                    'confidence': confidence
                })
            else:
                # 检查是否需要更新离开记录
                last_entry = self.entries[person_id]
                if isinstance(last_entry, datetime) and current_time - last_entry > self.cooldown_period:
                    # 记录离开
                    self.entries[person_id] = None
                    self.attendance_records.append({
                        'person_id': person_id,
                        'event_type': 'exit',
                        'timestamp': current_time,
                        'location_id': self.location_id
                    })

        # 清理长时间未出现的人员（30分钟）
        self._cleanup_old_entries(current_time)

        return self.attendance_records[-5:]  # 返回最近5条记录
