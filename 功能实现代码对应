import cv2

class FaceRecognizer:
    def __init__(self, reference_encodings):
        # 初始化多种识别算法
        self.algorithms = {
            'face_recognition': self._recognize_face_recognition,
            'insightface': self._recognize_insightface,
            'opencv': self._recognize_opencv
        }
        # 参考编码库
