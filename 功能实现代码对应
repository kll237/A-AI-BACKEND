def detect_multiscale(self, frame, scales=[0.5, 1.0, 1.5]):
    detections = []
    original_size = frame.shape[:2]

    for scale in scales:
        # 调整图像大小（《计算机视觉教程》4.3节 尺度空间理论）
        scaled_frame = cv2.resize(
            frame,
            (int(original_size[1] * scale), int(original_size[0] * scale))
        )

        # 在当前尺度检测
        scale_detections = self.model(scaled_frame, classes=[0])

        # 将检测结果映射回原始尺度
        for det in self._parse_results(scale_detections):
            # 坐标缩放
            det['bbox'] = [
                coord / scale for coord in det['bbox']
            ]
            detections.append(det)

    # 非极大值抑制去除重复检测（教程12.4节 NMS算法）
    return self._non_max_suppression(detections)
